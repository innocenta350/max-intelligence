# TriMet API
TRIMET_APP_ID=

# Polling
POLL_INTERVAL_S=10
FULL_RECONCILE_S=300

# Quota
QUOTA_BUDGET=1000000
QUOTA_RESET_TZ=America/Los_Angeles
QUOTA_RESET_TIME=00:00

# Static GTFS (M1) — see backend/trimet/config.py for all GTFS_* variables
GTFS_FEED_URL=
GTFS_WORK_DIR=

# Live polling (M2 / S10) — see backend/trimet/live_config.py
# The AppID above is shared by the polling clients.
# Quota (application policy; a configurable ceiling, not a verified TriMet meter):
TRIMET_QUOTA_DAILY_BUDGET=1000000
# Required numeric opening estimate. If today's true usage is unknown, set
# this to the full daily budget (1000000) so polling starts halting and the
# operator consciously lowers it after observing metered usage.
TRIMET_QUOTA_INITIAL_USED=1000000
TRIMET_QUOTA_RESET_TIME=00:00
TRIMET_QUOTA_RESET_ZONE=UTC
# Poll cadence (seconds)
TRIMET_VEHICLES_POLL_SECONDS=10
TRIMET_TRIPUPDATES_POLL_SECONDS=60
TRIMET_ALERTS_POLL_SECONDS=120
TRIMET_VEHICLES_FULL_SECONDS=300